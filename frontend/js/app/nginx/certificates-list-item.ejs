<div>
    <% if (id > 0) { %>
        <div class="title">
            <i class="fe fe-shield text-pink"></i> <%- certificate_type === 'custom' ? nice_name : domain_names.join(', ') %>
        </div>
        <span class="description"><%- i18n('tls', certificate_type) %> &ndash; Expires: <%- formatDbDate(expires_on, 'Do MMMM YYYY, h:mm a') %></span>
    <% } else { %>
        <div class="title">
            <i class="fe fe-shield-off text-danger"></i> <%- i18n('all-hosts', 'none') %>
        </div>
        <span class="description"><%- i18n('all-hosts', 'no-tls') %></span>
    <% } %>
</div>
