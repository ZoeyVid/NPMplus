<div class="modal-content">
  <div class="modal-header">
    <h5 class="modal-title">
      <% if (isNew) { %><%- i18n('acme-servers', 'add') %><% } else { %><%- i18n('acme-servers', 'edit') %><% } %>
    </h5>
    <button type="button" class="close cancel" aria-label="Close" data-dismiss="modal">&nbsp;</button>
  </div>
  <div class="modal-body has-tabs">
    <div class="alert alert-danger mb-0 rounded-0" style="display: none;" role="alert"></div>
    <form>
      <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="nav-item">
          <a href="#details" aria-controls="tab1" role="tab" data-toggle="tab" class="nav-link active">
            <i class="fe fe-server"></i> <%- i18n('all-hosts', 'details') %>
          </a>
        </li>
        <li role="presentation" class="nav-item">
          <a href="#authentication" aria-controls="tab2" role="tab" data-toggle="tab" class="nav-link">
            <i class="fe fe-key"></i> <%- i18n('acme-servers', 'authentication') %>
          </a>
        </li>
        <li role="presentation" class="nav-item">
          <a href="#advanced" aria-controls="tab3" role="tab" data-toggle="tab" class="nav-link">
            <i class="fe fe-settings"></i> <%- i18n('all-hosts', 'advanced') %>
          </a>
        </li>
      </ul>
      
      <div class="tab-content">
        <!-- Details Tab -->
        <div role="tabpanel" class="tab-pane active" id="details">
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <label class="form-label"><%- i18n('str', 'name') %> <span class="form-required">*</span></label>
                <input
                  type="text"
                  name="name"
                  class="form-control"
                  placeholder="<%- i18n('acme-servers', 'name-placeholder') %>"
                  required
                />
                <small class="form-hint"><%- i18n('acme-servers', 'name-help') %></small>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="form-group">
                <label class="form-label"><%- i18n('acme-servers', 'description') %></label>
                <input
                  type="text"
                  name="description"
                  class="form-control"
                  placeholder="<%- i18n('acme-servers', 'description-placeholder') %>"
                />
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-sm-12">
              <div class="form-group">
                <label class="form-label"><%- i18n('acme-servers', 'server-url') %> <span class="form-required">*</span></label>
                <input
                  type="url"
                  name="server_url"
                  class="form-control"
                  placeholder="https://acme-v02.api.letsencrypt.org/directory"
                  required
                />
                <small class="form-hint"><%- i18n('acme-servers', 'server-url-help') %></small>
              </div>
            </div>
          </div>
          
          <div class="row">
            <div class="col-sm-12">
              <div class="form-group">
                <label class="form-label"><%- i18n('str', 'email') %></label>
                <input
                  type="email"
                  name="email"
                  class="form-control"
                  placeholder="admin@example.com"
                />
                <small class="form-hint"><%- i18n('acme-servers', 'email-help') %></small>
              </div>
            </div>
          </div>
        </div>

        <!-- Authentication Tab -->
        <div role="tabpanel" class="tab-pane" id="authentication">
          <div class="row">
            <div class="col-sm-12">
              <div class="form-group">
                <label class="custom-switch">
                  <input type="checkbox" name="show_eab" class="custom-switch-input" />
                  <span class="custom-switch-indicator"></span>
                  <span class="custom-switch-description"><%- i18n('acme-servers', 'enable-eab') %></span>
                </label>
              </div>
            </div>
          </div>

          <div class="eab-section" style="display: none;">
            <div class="row">
              <div class="col-sm-6">
                <div class="form-group">
                  <label class="form-label"><%- i18n('acme-servers', 'eab-kid') %></label>
                  <input type="text" name="eab_kid" class="form-control" placeholder="Key Identifier" />
                  <small class="form-hint"><%- i18n('acme-servers', 'eab-kid-help') %></small>
                </div>
              </div>
              <div class="col-sm-6">
                <div class="form-group">
                  <label class="form-label"><%- i18n('acme-servers', 'eab-hmac-key') %></label>
                  <input type="password" name="eab_hmac_key" class="form-control" placeholder="HMAC Key" />
                  <small class="form-hint"><%- i18n('acme-servers', 'eab-hmac-key-help') %></small>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Advanced Tab -->
        <div role="tabpanel" class="tab-pane" id="advanced">
          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <label class="form-label"><%- i18n('acme-servers', 'profile') %></label>
                <select name="profile" class="form-control custom-select">
                  <option value="none"><%- i18n('acme-servers', 'profile-none') %></option>
                </select>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="form-group">
                <label class="form-label"><%- i18n('acme-servers', 'key-type') %></label>
                <select name="key_type" class="form-control custom-select">
                  <option value="ecdsa">ECDSA</option>
                  <option value="rsa">RSA</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <label class="custom-switch">
                  <input type="checkbox" name="must_staple" class="custom-switch-input" />
                  <span class="custom-switch-indicator"></span>
                  <span class="custom-switch-description"><%- i18n('acme-servers', 'must-staple') %></span>
                </label>
              </div>
            </div>
            <div class="col-sm-6">
              <div class="form-group">
                <label class="custom-switch">
                  <input type="checkbox" name="ocsp_stapling" class="custom-switch-input" />
                  <span class="custom-switch-indicator"></span>
                  <span class="custom-switch-description"><%- i18n('acme-servers', 'ocsp-stapling') %></span>
                </label>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-sm-6">
              <div class="form-group">
                <label class="custom-switch">
                  <input type="checkbox" name="tls_verify" class="custom-switch-input" checked />
                  <span class="custom-switch-indicator"></span>
                  <span class="custom-switch-description"><%- i18n('acme-servers', 'tls-verify') %></span>
                </label>
              </div>
            </div>
          </div>
        </div>
      </div>
    </form>
  </div>
  <div class="modal-footer">
    <button type="button" class="btn btn-secondary cancel" data-dismiss="modal">
      <%- i18n('str', 'cancel') %>
    </button>
    <button type="submit" class="btn btn-primary save">
      <i class="fe fe-save"></i>
      <%- i18n('str', 'save') %>
    </button>
  </div>
</div>
