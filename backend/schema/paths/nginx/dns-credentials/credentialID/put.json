{
	"operationId": "updateDnsCredentials",
	"summary": "Update DNS Credentials",
	"tags": [
		"dns-credentials"
	],
	"security": [
		{
			"cookieAuth": [
				"settings.manage"
			]
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "credentialID",
			"description": "DNS Credentials ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			},
			"required": true,
			"example": 1
		}
	],
	"requestBody": {
		"description": "DNS Credentials Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"minProperties": 1,
					"properties": {
						"provider_id": {
							"$ref": "../../../../components/dns-credentials-object.json#/properties/provider_id"
						},
						"credentials": {
							"$ref": "../../../../components/dns-credentials-object.json#/properties/credentials"
						},
						"name": {
							"$ref": "../../../../components/dns-credentials-object.json#/properties/name"
						}
					}
				},
				"example": {
					"provider_id": "cloudflare",
					"name": "My Updated Credentials",
					"credentials": "{\"api_key\": \"new-api-key\"}"
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"id": 1,
								"created_on": "2024-10-09T05:31:58.000Z",
								"modified_on": "2024-10-09T06:15:00.000Z",
								"owner_user_id": 1,
								"name": "My Updated Credentials",
								"provider_id": "cloudflare",
								"credentials": "***"
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/dns-credentials-object.json"
					}
				}
			}
		},
		"400": {
			"description": "400 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 400,
									"message": "Invalid request"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/error.json"
					}
				}
			}
		},
		"404": {
			"description": "404 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"error": {
									"code": 404,
									"message": "Item not found"
								}
							}
						}
					},
					"schema": {
						"$ref": "../../../../components/error.json"
					}
				}
			}
		}
	}
}
