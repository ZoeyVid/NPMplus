{
	"operationId": "testHttpReach",
	"summary": "Test HTTP Reachability",
	"tags": [
		"certificates"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"requestBody": {
		"description": "Test Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"domains"
					],
					"properties": {
						"domains": {
							"$ref": "../../../../components/certificate-object.json#/properties/domain_names_http"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": [
								{
									"domain": "test.example.org",
									"status": "ok"
								},
								{
									"domain": "test.example.com",
									"status": "other:Invalid domain or IP"
								},
								{
									"domain": "nonexistent.example.com",
									"status": "404"
								}
							]
						}
					},
					"schema": {
						"type": "array",
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": [
								"domain",
								"status"
							],
							"properties": {
								"domain": {
									"type": "string",
									"example": "test.example.org"
								},
								"status": {
									"type": "string",
									"description": "ok, failed, wrong-data, 404, no-host or other:<message>",
									"example": "ok"
								}
							}
						}
					}
				}
			}
		}
	}
}
