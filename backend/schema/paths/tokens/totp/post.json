{
	"operationId": "loginWithTotp",
	"summary": "Verify TOTP code and get full token",
	"tags": ["tokens"],
	"requestBody": {
		"description": "totp Challenge Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"additionalProperties": false,
					"properties": {
						"code": {
							"minLength": 6,
							"maxLength": 8,
							"type": "string",
							"example": "012345"
						}
					},
					"required": ["code"],
					"type": "object"
				},
				"example": {
					"code": "012345"
				}
			}
		}
	},
	"responses": {
		"200": {
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"expires": "2025-02-04T20:40:46.340Z"
							}
						}
					},
					"schema": {
						"$ref": "../../../components/token-object.json"
					}
				}
			},
			"description": "200 response"
		}
	}
}
