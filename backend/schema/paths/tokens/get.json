{
	"operationId": "refreshToken",
	"summary": "Refresh your access token",
	"tags": [
		"tokens"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "querystring",
			"name": "querystring",
			"content": {
				"application/x-www-form-urlencoded": {
					"schema": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"expires_in": {
								"description": "Lifetime of the new token in hours, capped by the TOKEN_MAX_EXPIRY env (in hours, default 1)",
								"type": "integer",
								"minimum": 1,
								"default": 1,
								"example": 720
							}
						}
					}
				}
			}
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": {
								"expires": "2025-02-04T20:40:46.340Z"
							}
						}
					},
					"schema": {
						"$ref": "../../components/token-object.json"
					}
				}
			}
		}
	}
}
