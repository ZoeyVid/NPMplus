{
	"operationId": "updateUserAuth",
	"summary": "Update a User's Authentication",
	"tags": [
		"users"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "user_id",
			"schema": {
				"type": "integer",
				"minimum": 1,
				"maximum": 2147483647
			},
			"required": true,
			"description": "User ID or 'me' for yourself",
			"example": 2
		}
	],
	"requestBody": {
		"description": "Auth Payload",
		"required": true,
		"content": {
			"application/json": {
				"schema": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"type",
						"secret"
					],
					"properties": {
						"type": {
							"type": "string",
							"const": "password",
							"example": "password"
						},
						"current": {
							"type": "string",
							"minLength": 1,
							"maxLength": 255,
							"example": "changeme"
						},
						"secret": {
							"type": "string",
							"minLength": 8,
							"maxLength": 255,
							"example": "mySuperN3wP@ssword!"
						}
					}
				}
			}
		}
	},
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"examples": {
						"default": {
							"value": true
						}
					},
					"schema": {
						"type": "boolean"
					}
				}
			}
		}
	}
}
