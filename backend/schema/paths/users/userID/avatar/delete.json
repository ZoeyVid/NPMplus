{
	"operationId": "deleteUserAvatar",
	"summary": "Remove the custom avatar of a user, falling back to gravatar",
	"tags": [
		"users"
	],
	"security": [
		{
			"cookieAuth": []
		}
	],
	"parameters": [
		{
			"in": "path",
			"name": "userID",
			"schema": {
				"oneOf": [
					{
						"type": "string",
						"pattern": "^me$"
					},
					{
						"type": "integer",
						"minimum": 1
					}
				]
			},
			"required": true,
			"description": "User ID or 'me' for yourself",
			"example": 2
		}
	],
	"responses": {
		"200": {
			"description": "200 response",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../../../components/user-object.json"
					}
				}
			}
		}
	}
}
