{
	"type": "object",
	"description": "Certificate object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"provider",
		"nice_name",
		"domain_names",
		"expires_on",
		"npmplus_reuse_key",
		"npmplus_dns_challenge",
		"npmplus_dns_provider",
		"npmplus_propagation_seconds"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"provider": {
			"$ref": "../common.json#/properties/ssl_provider"
		},
		"nice_name": {
			"type": "string",
			"description": "Nice Name for the custom certificate",
			"maxLength": 255,
			"default": "",
			"example": "My Custom Cert"
		},
		"domain_names": {
			"description": "Domain Names array",
			"type": "array",
			"minItems": 1,
			"maxItems": 25,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"maxLength": 253
			},
			"example": [
				"example.com",
				"www.example.com"
			]
		},
		"domain_names_http": {
			"description": "Domain Names and IPs for the HTTP challenge, wildcards are not allowed",
			"type": "array",
			"minItems": 1,
			"maxItems": 25,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"maxLength": 253,
				"pattern": "^(([\\p{L}\\p{Mn}\\p{Mc}\\p{Nd}\\-]+\\.)+[\\p{L}\\p{Mn}\\p{Mc}\\p{Nd}\\-]+|\\[[0-9a-fA-F:]+\\])$"
			},
			"example": [
				"example.com",
				"192.0.2.1",
				"[2001:db8::1]"
			]
		},
		"domain_names_dns": {
			"description": "Domain Names for the DNS challenge, wildcards are allowed, IPs are not allowed",
			"type": "array",
			"minItems": 1,
			"maxItems": 25,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"maxLength": 253,
				"pattern": "^(?![0-9.]+$)(\\*\\.)?([\\p{L}\\p{Mn}\\p{Mc}\\p{Nd}\\-]+\\.)+[\\p{L}\\p{Mn}\\p{Mc}\\p{Nd}\\-]+$"
			},
			"example": [
				"example.com",
				"*.example.com"
			]
		},
		"expires_on": {
			"description": "Date and time of expiration",
			"readOnly": true,
			"type": "string",
			"example": "2025-10-28T04:17:54.000Z"
		},
		"owner": {
			"$ref": "./user-object.json"
		},
		"npmplus_reuse_key": {
			"description": "Reuse the private key on renewal",
			"type": "boolean",
			"default": false,
			"example": false
		},
		"npmplus_dns_challenge": {
			"description": "Use the DNS challenge",
			"type": "boolean",
			"default": false,
			"example": false
		},
		"npmplus_dns_provider": {
			"description": "DNS provider",
			"type": "string",
			"maxLength": 255,
			"default": "",
			"example": "cloudflare"
		},
		"npmplus_dns_provider_credentials": {
			"description": "DNS provider credentials",
			"type": "string",
			"writeOnly": true,
			"default": "",
			"example": "dns_cloudflare_api_token=123"
		},
		"npmplus_propagation_seconds": {
			"description": "DNS propagation seconds, 0 uses the default of the DNS plugin",
			"type": "integer",
			"minimum": 0,
			"maximum": 7200,
			"default": 0,
			"example": 0
		}
	}
}
