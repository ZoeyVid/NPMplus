{
	"$defs": {
		"port": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535
		},
		"upstreamServers": {
			"type": "array",
			"minItems": 1,
			"prefixItems": [
				{
					"$ref": "./upstream-server-object.json"
				}
			],
			"items": {
				"allOf": [
					{
						"$ref": "./upstream-server-object.json"
					},
					{
						"properties": {
							"port": {
								"oneOf": [
									{
										"$ref": "#/$defs/port"
									},
									{
										"type": "null"
									}
								]
							}
						}
					}
				]
			},
			"example": [
				{
					"host": "example.com",
					"port": 80,
					"max_conns": 1,
					"weight": 2,
					"backup": true,
					"down": false,
					"fail_timeout": "60s"
				}
			]
		},
		"proxyUpstreamServers": {
			"allOf": [
				{
					"$ref": "#/$defs/upstreamServers"
				},
				{
					"prefixItems": [
						{
							"properties": {
								"port": {
									"oneOf": [
										{
											"$ref": "#/$defs/port"
										},
										{
											"type": "null"
										}
									]
								}
							}
						}
					]
				}
			]
		},
		"singleProxyUpstreamServer": {
			"allOf": [
				{
					"$ref": "#/$defs/proxyUpstreamServers"
				},
				{
					"maxItems": 1
				}
			]
		},
		"proxySchemeUpstreamRequirement": {
			"if": {
				"properties": {
					"forward_scheme": {
						"enum": [
							"path",
							"empty"
						]
					}
				},
				"required": [
					"forward_scheme"
				]
			},
			"then": {
				"properties": {
					"npmplus_upstream_servers": {
						"$ref": "#/$defs/singleProxyUpstreamServer"
					}
				}
			},
			"else": {
				"properties": {
					"npmplus_upstream_servers": {
						"$ref": "#/$defs/proxyUpstreamServers"
					}
				}
			}
		},
		"loadBalanceMethodRequirement": {
			"if": {
				"properties": {
					"npmplus_upstream_servers": {
						"minItems": 2
					}
				},
				"required": [
					"npmplus_upstream_servers"
				]
			},
			"then": {
				"required": [
					"npmplus_load_balance_method"
				]
			},
			"else": {
				"not": {
					"required": [
						"npmplus_load_balance_method"
					]
				}
			}
		},
		"partialLoadBalanceMethodRequirement": {
			"if": {
				"required": [
					"npmplus_upstream_servers"
				]
			},
			"then": {
				"$ref": "#/$defs/loadBalanceMethodRequirement"
			}
		},
		"forwardPathSchemeRequirement": {
			"if": {
				"required": [
					"npmplus_forward_path"
				]
			},
			"then": {
				"properties": {
					"forward_scheme": {
						"enum": [
							"http",
							"https"
						]
					}
				},
				"required": [
					"forward_scheme"
				]
			}
		},
		"partialForwardPathSchemeRequirement": {
			"if": {
				"properties": {
					"npmplus_forward_path": {
						"type": "string"
					}
				},
				"required": [
					"npmplus_forward_path",
					"forward_scheme"
				]
			},
			"then": {
				"properties": {
					"forward_scheme": {
						"enum": [
							"http",
							"https"
						]
					}
				}
			}
		}
	}
}
