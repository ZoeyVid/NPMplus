{
	"$defs": {
		"port": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535
		},
		"upstreamServers": {
			"type": "array",
			"minItems": 1,
			"prefixItems": [
				{
					"$ref": "./upstream-server-object.json"
				}
			],
			"items": {
				"allOf": [
					{
						"$ref": "./upstream-server-object.json"
					},
					{
						"properties": {
							"port": {
								"oneOf": [
									{
										"$ref": "#/$defs/port"
									},
									{
										"type": "null"
									}
								]
							}
						}
					}
				]
			},
			"default": [],
			"example": [
				{
					"host": "example.com",
					"port": 80,
					"max_conns": 1,
					"weight": 2,
					"backup": true,
					"down": false,
					"fail_timeout": "60s"
				}
			]
		},
		"loadBalanceMethodRequirement": {
			"if": {
				"properties": {
					"npmplus_upstream_servers": {
						"minItems": 2
					}
				},
				"required": [
					"npmplus_upstream_servers"
				]
			},
			"then": {
				"required": [
					"npmplus_load_balance_method"
				]
			},
			"else": {
				"not": {
					"required": [
						"npmplus_load_balance_method"
					]
				}
			}
		},
		"partialLoadBalanceMethodRequirement": {
			"if": {
				"required": [
					"npmplus_upstream_servers"
				]
			},
			"then": {
				"$ref": "#/$defs/loadBalanceMethodRequirement"
			}
		}
	}
}
