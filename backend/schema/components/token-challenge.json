{
	"type": "object",
	"description": "Token object",
	"required": ["requiresTotp", "expires"],
	"additionalProperties": false,
	"properties": {
		"requiresTotp": {
			"description": "Whether TOTP is enabled for this user",
			"example": true,
			"type": "boolean"
		},
		"expires": {
			"description": "Token Expiry ISO Time String",
			"example": "2025-02-04T20:40:46.340Z",
			"type": "string"
		}
	}
}
