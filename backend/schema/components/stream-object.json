{
	"type": "object",
	"description": "Stream object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"incoming_port",
		"npmplus_upstream_servers",
		"tcp_forwarding",
		"udp_forwarding",
		"npmplus_proxy_protocol_forwarding",
		"npmplus_proxy_tls",
		"enabled",
		"npmplus_advanced_config",
		"npmplus_description",
		"certificate_id",
		"meta"
	],
	"allOf": [
		{
			"$ref": "./load-balancing.json#/$defs/loadBalanceMethodRequirement"
		}
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"incoming_port": {
			"type": "string",
			"pattern": "^([0-9]{1,5}$|[0-9]{1,5}-[0-9]{1,5}$)",
			"maxLength": 11,
			"example": 9090
		},
		"npmplus_load_balance_method": {
			"type": "string",
			"enum": [
				"round_robin",
				"least_conn",
				"hash",
				"hash_consistent",
				"least_time_connect",
				"least_time_first_byte",
				"least_time_last_byte",
				"least_time_last_byte_inflight",
				"random",
				"random_two_least_connections",
				"random_two_least_time_connect",
				"random_two_least_time_first_byte",
				"random_two_least_time_last_byte"
			],
			"default": "round_robin",
			"example": "round_robin"
		},
		"npmplus_upstream_servers": {
			"allOf": [
				{
					"$ref": "./load-balancing.json#/$defs/upstreamServers"
				},
				{
					"if": {
						"prefixItems": [
							{
								"required": [
									"port"
								],
								"properties": {
									"port": {
										"const": "$server_port"
									}
								}
							}
						]
					},
					"then": {
						"maxItems": 1
					}
				}
			]
		},
		"tcp_forwarding": {
			"type": "boolean",
			"example": true
		},
		"udp_forwarding": {
			"type": "boolean",
			"example": false
		},
		"npmplus_proxy_protocol_forwarding": {
			"type": "integer",
			"enum": [0, 1, 2],
			"example": 0
		},
		"npmplus_proxy_tls": {
			"type": "boolean",
			"example": false
		},
		"enabled": {
			"$ref": "../common.json#/properties/enabled"
		},
		"certificate_id": {
			"description": "Certificate ID",
			"type": "integer",
			"minimum": 0,
			"example": 5
		},
		"npmplus_advanced_config": {
			"type": "string",
			"example": ""
		},
		"meta": {
			"type": "object",
			"example": {}
		},
		"npmplus_description": {
			"type": "string",
			"maxLength": 255,
			"example": "MariaDB database connection"
		},
		"certificate": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "./certificate-object.json"
				}
			],
			"example": null
		},
		"owner": {
			"$ref": "./user-object.json"
		}
	}
}
