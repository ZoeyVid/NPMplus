{
	"type": "object",
	"description": "Stream object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"incoming_port",
		"npmplus_load_balance_method",
		"npmplus_upstream_servers",
		"tcp_forwarding",
		"udp_forwarding",
		"npmplus_proxy_protocol_forwarding",
		"npmplus_proxy_tls",
		"enabled",
		"npmplus_advanced_config",
		"npmplus_description",
		"certificate_id",
		"meta"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"incoming_port": {
			"type": "string",
			"pattern": "^([0-9]{1,5}$|[0-9]{1,5}-[0-9]{1,5}$)",
			"maxLength": 11,
			"example": 9090
		},
		"npmplus_load_balance_method": {
			"type": "string",
			"enum": [
				"round_robin",
				"least_conn",
				"ip_hash",
				"least_time_connect",
				"least_time_header",
				"least_time_last_byte",
				"least_time_last_byte_inflight",
				"random",
				"random_two_least_connections",
				"random_two_least_time_connect",
				"random_two_least_time_header",
				"random_two_least_time_last_byte"
			],
			"default": "round_robin",
			"example": "round_robin"
		},
		"npmplus_upstream_servers": {
			"type": "array",
			"minItems": 1,
			"prefixItems": [
				{
					"allOf": [
						{
							"$ref": "./upstream-server-object.json"
						},
						{
							"required": [
								"port"
							],
							"properties": {
								"port": {
									"type": "integer",
									"minimum": 1,
									"maximum": 65535
								}
							}
						}
					]
				}
			],
			"items": {
				"$ref": "./upstream-server-object.json"
			},
			"default": [],
			"example": [{
							"host": "example.com",
							"port": 80,
							"max_conns": 1,
							"weight": 2,
							"least_conn": 2,
							"down": false,
							"fail_timeout": "60s"
						}]
		},
		"tcp_forwarding": {
			"type": "boolean",
			"example": true
		},
		"udp_forwarding": {
			"type": "boolean",
			"example": false
		},
		"npmplus_proxy_protocol_forwarding": {
			"type": "integer",
			"enum": [0, 1, 2],
			"example": 0
		},
		"npmplus_proxy_tls": {
			"type": "boolean",
			"example": false
		},
		"enabled": {
			"$ref": "../common.json#/properties/enabled"
		},
		"certificate_id": {
			"description": "Certificate ID",
			"type": "integer",
			"minimum": 0,
			"example": 5
		},
		"npmplus_advanced_config": {
			"type": "string",
			"example": ""
		},
		"meta": {
			"type": "object",
			"example": {}
		},
		"npmplus_description": {
			"type": "string",
			"maxLength": 255,
			"example": "MariaDB database connection"
		},
		"certificate": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "./certificate-object.json"
				}
			],
			"example": null
		},
		"owner": {
			"$ref": "./user-object.json"
		}
	}
}
