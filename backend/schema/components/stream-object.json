{
	"type": "object",
	"description": "Stream object",
	"required": [
		"id",
		"created_on",
		"modified_on",
		"owner_user_id",
		"incoming_port",
		"forwarding_host",
		"forwarding_port",
		"tcp_forwarding",
		"udp_forwarding",
		"npmplus_proxy_protocol_forwarding",
		"npmplus_proxy_tls",
		"enabled",
		"npmplus_advanced_config",
		"npmplus_description",
		"certificate_id",
		"npmplus_nginx_online",
		"npmplus_nginx_err",
		"npmplus_directory",
		"npmplus_mtls_certificate_id",
		"npmplus_mtls_verify_client_optional"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"$ref": "../common.json#/properties/id"
		},
		"created_on": {
			"$ref": "../common.json#/properties/created_on"
		},
		"modified_on": {
			"$ref": "../common.json#/properties/modified_on"
		},
		"owner_user_id": {
			"$ref": "../common.json#/properties/user_id"
		},
		"incoming_port": {
			"type": "string",
			"pattern": "^([0-9]{1,5}$|[0-9]{1,5}-[0-9]{1,5}$)",
			"maxLength": 11,
			"example": 9090
		},
		"forwarding_host": {
			"type": "string",
			"minLength": 1,
			"maxLength": 253,
			"pattern": "^\\S+$",
			"example": "127.0.0.1"
		},
		"forwarding_port": {
			"type": "string",
			"pattern": "^([0-9]{0,5}|\\$server_port)$",
			"maxLength": 12,
			"default": "",
			"example": 80
		},
		"tcp_forwarding": {
			"type": "boolean",
			"default": false,
			"example": true
		},
		"udp_forwarding": {
			"type": "boolean",
			"default": false,
			"example": false
		},
		"npmplus_proxy_protocol_forwarding": {
			"type": "integer",
			"enum": [0, 1, 2],
			"default": 0,
			"example": 0
		},
		"npmplus_proxy_tls": {
			"type": "boolean",
			"default": false,
			"example": false
		},
		"enabled": {
			"$ref": "../common.json#/properties/enabled"
		},
		"certificate_id": {
			"$ref": "../common.json#/properties/certificate_id"
		},
		"npmplus_advanced_config": {
			"type": "string",
			"default": "",
			"example": ""
		},
		"npmplus_nginx_online": {
			"$ref": "../common.json#/properties/npmplus_nginx_online"
		},
		"npmplus_nginx_err": {
			"$ref": "../common.json#/properties/npmplus_nginx_err"
		},
		"npmplus_directory": {
			"$ref": "../common.json#/properties/npmplus_directory"
		},
		"npmplus_mtls_certificate_id": {
			"$ref": "../common.json#/properties/npmplus_mtls_certificate_id"
		},
		"npmplus_mtls_verify_client_optional": {
			"$ref": "../common.json#/properties/npmplus_mtls_verify_client_optional"
		},
		"npmplus_description": {
			"type": "string",
			"maxLength": 255,
			"default": "",
			"example": "MariaDB database connection"
		},
		"certificate": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"$ref": "./certificate-object.json"
				}
			],
			"example": null
		},
		"owner": {
			"$ref": "./user-object.json"
		}
	}
}
