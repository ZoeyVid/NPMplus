{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!**/*.json"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineWidth": 120,
		"formatWithErrors": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "all",
			"complexity": {
				"noExcessiveCognitiveComplexity": "warn",
				"noExcessiveLinesPerFunction": "warn",
				"noVoid": "warn",
				"useSimplifiedLogicExpression": "warn"
			},
			"correctness": {
				"noNodejsModules": "warn",
				"noProcessGlobal": "warn",
				"noUnresolvedImports": "warn",
				"useQwikValidLexicalScope": "warn"
			},
			"nursery": {
				"noFloatingPromises": "error"
			},
			"performance": {
				"noAwaitInLoops": "warn",
				"noDelete": "warn"
			},
			"style": {
				"noContinue": "warn",
				"noDefaultExport": "warn",
				"noExcessiveLinesPerFile": "warn",
				"noIncrementDecrement": "warn",
				"noMagicNumbers": "warn",
				"noNegationElse": "warn",
				"noProcessEnv": "warn",
				"noTernary": "warn",
				"useBlockStatements": "warn",
				"useConsistentObjectDefinitions": "warn",
				"useDestructuring": "warn",
				"useErrorCause": "warn",
				"useNamingConvention": "warn",
				"useNumericSeparators": "warn"
			},
			"suspicious": {
				"noConsole": "warn",
				"noEmptyBlockStatements": "warn",
				"noImportCycles": "warn",
				"noUnnecessaryConditions": "warn"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
