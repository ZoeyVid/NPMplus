@@ -194,3 +194,22 @@ END
     fi
 
 fi
+
+
+if [ $OPENSSL = YES ]; then
+
+    ngx_feature="brotli library for certificate compression"
+    ngx_feature_name="NGX_SSL_BROTLI"
+    ngx_feature_run=no
+    ngx_feature_incs="#include <openssl/ssl.h>
+                      #include <brotli/encode.h>"
